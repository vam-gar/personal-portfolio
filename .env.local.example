# Copy this file to .env.local and fill in the values.
# .env.local is gitignored; never commit real keys.

# --- Required ---

# Gemini API key for vamsi-bot (chat + embeddings).
# Get one at https://aistudio.google.com/app/apikey
# Server-only: no NEXT_PUBLIC_ prefix, so it never reaches the browser.
GEMINI_API_KEY=your-gemini-api-key

# Contact form delivery (Formspree). Create a form at https://formspree.io,
# set its destination email, and paste the endpoint URL here.
# Used by the #contact-form channel and by the bot's draft card.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# --- Optional ---

# Chat model. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Judge model for `npm run eval` (groundedness only). Defaults to
# gemini-4-hydrogen. Must differ from the chat model so the two do not
# share a free-tier quota.
# JUDGE_MODEL=gemini-4-hydrogen

# GitHub token for the live stats tool. Without it, GitHub allows 60
# requests per hour per IP. A token with no scopes is enough.
# GITHUB_TOKEN=
